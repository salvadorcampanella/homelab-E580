{
  "name": "Casita Homelab Telegram AI Bot (Polling Mode)",
  "nodes": [
    {
      "parameters": {
        "interval": 5,
        "unit": "seconds"
      },
      "id": "trigger-interval-001",
      "name": "Poll Every 5s",
      "type": "n8n-nodes-base.interval",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates?limit=1&allowed_updates=[\"message\"]",
        "options": {}
      },
      "id": "http-get-updates-002",
      "name": "Get Telegram Updates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "result",
        "options": {}
      },
      "id": "item-lists-split-003",
      "name": "Split Updates",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.text }}",
                    "rightValue": "/status",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Status Command"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "switch-check-cmd-004",
      "name": "Check Command",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "🔒 *Casita Homelab Bot (Polling Mode Active)*\n\nStatus: 🟢 Online (Outbound Polling)\nNetwork: 100% Private (No Ports Opened)\nServer: Lenovo E580 (Ubuntu Server)",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-status-005",
      "name": "Send Status Response",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Casita Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "={{ \"🤖 Hola! Recibí tu mensaje en modo Polling Seguro: \\\"\" + $json.message.text + \"\\\"\" }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-default-006",
      "name": "Send Default Response",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        400
      ],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Casita Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates?offset={{ $('Split Updates').item.json.update_id + 1 }}",
        "options": {}
      },
      "id": "ack-offset-007",
      "name": "Acknowledge Update (Offset)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ]
    }
  ],
  "connections": {
    "Poll Every 5s": {
      "main": [
        [
          {
            "node": "Get Telegram Updates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Telegram Updates": {
      "main": [
        [
          {
            "node": "Split Updates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Updates": {
      "main": [
        [
          {
            "node": "Check Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Command": {
      "main": [
        [
          {
            "node": "Send Status Response",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Default Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Status Response": {
      "main": [
        [
          {
            "node": "Acknowledge Update (Offset)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Default Response": {
      "main": [
        [
          {
            "node": "Acknowledge Update (Offset)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

# --- GENERAL CONFIG ---
TZ=Europe/Madrid
DOCKER_DATA_PATH=/home/casita/docker-data

# --- NGINX PROXY MANAGER ---
DB_MYSQL_HOST=npm-db
DB_MYSQL_PORT=3306
DB_MYSQL_USER=npm
DB_MYSQL_PASSWORD=change_this_npm_password
DB_MYSQL_NAME=npm
DB_MYSQL_ROOT_PASSWORD=change_this_root_password
# Admin panel credentials (used by setup-npm-hosts.sh)
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=change_this_npm_admin_password

# --- PI-HOLE ---
PIHOLE_PASSWORD=change_this_pihole_password
# IP that Pi-hole DNS entries resolve to (the Docker host IP, seen from local network clients)
# Used by setup-npm-hosts.sh when creating *.casita.local DNS entries
PIHOLE_HOST_IP=192.168.1.X

# --- PORTAINER ---
# (Optional) Any specific portainer configs


# --- DUCKDNS ---
DUCKDNS_SUBDOMAINS=casitaogrove
DUCKDNS_TOKEN=change_this_token

# --- STACK ARR + JELLYFIN ---
# Sensitive variables are not required — configured via their web UI.
# Media folder is configured here for reference:
# MEDIA_PATH=${DOCKER_DATA_PATH}/media   (movies/ and tv/ as subfolders)

# --- GPU / HARDWARE ACCELERATION (Intel QuickSync / VAAPI) ---
# These are set directly in arr/docker-compose.yml (not here) because they depend
# on host group IDs detected at setup time. To re-detect on a new machine run:
#   getent group video render
# The x-gpu-access YAML anchor makes the GPU config reusable for Immich, Plex, etc.
# LIBVA_DRIVER_NAME=i965  → Recommended for UHD 620 compatibility on this host
#                    iHD   → Intel Media Driver (Gen 8+, newer but sometimes unstable)

# --- FLARESOLVERR ---
# Log level: info | debug (use debug to troubleshoot indexer issues)
FLARESOLVERR_LOG_LEVEL=info

# --- HOMEPAGE ---
# Service API keys are configured directly in:
# ${DOCKER_DATA_PATH}/homepage/config/services.yaml
# Refer to comments in that file to find where to get each key.

# --- PHOTOPRISM ---
PHOTOPRISM_DB_ROOT_PASSWORD=change_this_root_password
PHOTOPRISM_DB_USER=photoprism
PHOTOPRISM_DB_PASSWORD=change_this_db_password
PHOTOPRISM_PERSONAL_ADMIN_USER=admin
PHOTOPRISM_PERSONAL_ADMIN_PASSWORD=change_this_personal_admin_password
PHOTOPRISM_COMPARTIDO_ADMIN_USER=admin
PHOTOPRISM_COMPARTIDO_ADMIN_PASSWORD=change_this_compartido_admin_password

# --- MONITORING ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_admin_password

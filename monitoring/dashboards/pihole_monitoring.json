    "panel-1": {
      "kind": "Panel",
      "spec": {
        "id": 1,
        "title": "Consultas Totales",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": {
                      "name": "prometheus"
                    },
                    "spec": {
                      "expr": "sum(sum_over_time(pihole_query_status_1m[$__range]))"
                    }
                  },
                  "refId": "A",
                  "hidden": false
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "stat",
          "version": "",
          "spec": {
            "options": {
              "colorMode": "value",
              "graphMode": "none",
              "reduceOptions": {
                "calcs": [
                  "lastNotNull"
                ],
                "values": false
              },
              "text": {
                "titleSize": 12,
                "valueSize": 22
              }
            },
            "fieldConfig": {
              "defaults": {
                "unit": "short",
                "color": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              "overrides": []
            }
          }
        }
      }
    },
    "panel-10": {

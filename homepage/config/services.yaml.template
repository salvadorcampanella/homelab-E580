# Homepage — Homelab Services
# Docs: https://gethomepage.dev/configs/services/

- System Overview:
    - Glances System Monitor:
        icon: glances.png
        href: https://glances.salvador512.com
        description: System monitor & processes
        container: glances
        server: docker-local
        widget:
          type: glances
          url: http://glances:61208
          version: 4
          metric: cpu

    - Public IP:
        icon: router.png
        href: https://api.ipify.org
        description: Public IP Address
        widget:
          type: customapi
          url: https://api.ipify.org?format=json
          mappings:
            - field: ip
              label: IP

    - Grafana:
        icon: grafana.png
        href: https://grafana.salvador512.com
        description: Metrics dashboards & SRE
        container: grafana
        server: docker-local

- Live:
    - PhotoPrism Personal:
        icon: photoprism.png
        href: https://fotos.salvador512.com
        description: Main gallery
        container: photoprism-personal
        server: docker-local

    - PhotoPrism Family:
        icon: photoprism.png
        href: https://familia.salvador512.com
        description: Shared gallery
        container: photoprism-compartido
        server: docker-local

- Infrastructure & Automation:
    - Nginx Proxy Manager:
        icon: nginx-proxy-manager.png
        href: https://npm.salvador512.com
        description: Reverse Proxy and SSL
        container: nginx-proxy-manager
        server: docker-local

    - Pi-hole:
        icon: pi-hole.png
        href: https://pihole.salvador512.com/admin
        description: DNS + Ad-blocker
        container: pihole
        server: docker-local
        widget:
          type: pihole
          url: http://pihole
          version: 6
          key: <PIHOLE_API_KEY>   # Pi-hole > Settings > API / Web interface

    - n8n:
        icon: n8n.svg
        href: https://n8n.salvador512.com
        description: Workflow & AI automation
        container: n8n
        server: docker-local

    - Portainer:
        icon: portainer.png
        href: https://portainer.salvador512.com
        description: Visual Docker management
        container: portainer
        server: docker-local
        widget:
          type: portainer
          url: https://portainer:9443
          env: 3
          key: <PORTAINER_API_KEY>   # Portainer > Account > Access Tokens

- Media Center:
    - Jellyfin:
        icon: jellyfin.png
        href: https://jellyfin.salvador512.com
        description: Streaming server (Intel QuickSync GPU)
        container: jellyfin
        server: docker-local
        widget:
          type: jellyfin
          url: http://jellyfin:8096
          key: <JELLYFIN_API_KEY>   # Jellyfin > Dashboard > API Keys
          enableBlocks: true

    - Radarr:
        icon: radarr.png
        href: https://radarr.salvador512.com
        description: Movie management
        container: radarr
        server: docker-local
        widget:
          type: radarr
          url: http://radarr:7878
          key: <RADARR_API_KEY>    # Radarr > Settings > General > API Key

    - Sonarr:
        icon: sonarr.png
        href: https://sonarr.salvador512.com
        description: TV series management
        container: sonarr
        server: docker-local
        widget:
          type: sonarr
          url: http://sonarr:8989
          key: <SONARR_API_KEY>    # Sonarr > Settings > General > API Key

    - Tdarr:
        icon: tdarr.png
        href: https://tdarr.salvador512.com
        description: Transcoding (QuickSync GPU)
        container: tdarr
        server: docker-local
        widget:
          type: tdarr
          url: http://tdarr:8265

    - Prowlarr:
        icon: prowlarr.png
        href: https://prowlarr.salvador512.com
        description: Indexer manager
        container: prowlarr
        server: docker-local
        widget:
          type: prowlarr
          url: http://prowlarr:9696
          key: <PROWLARR_API_KEY>  # Prowlarr > Settings > General > API Key

    - qBittorrent:
        icon: qbittorrent.png
        href: https://qbit.salvador512.com
        description: Download client
        container: qbittorrent
        server: docker-local
        widget:
          type: qbittorrent
          url: http://qbittorrent:8080
          username: admin
          password: <QBIT_PASSWORD>   # qBittorrent web panel password

    - Bazarr:
        icon: bazarr.png
        href: https://bazarr.salvador512.com
        description: Subtitles management
        container: bazarr
        server: docker-local
        widget:
          type: bazarr
          url: http://bazarr:6767
          key: <BAZARR_API_KEY>    # Bazarr > Settings > General > API Key

# Homepage — Homelab Services
# Docs: https://gethomepage.dev/configs/services/
#
# IMPORTANT: replace values marked with <CHANGE_ME> with real ones:
#   - PIHOLE_API_KEY       → Pi-hole > Settings > API / Web interface > Show API Key
#   - JELLYFIN_API_KEY     → Jellyfin > Dashboard > API Keys > New key
#   - PORTAINER_API_KEY    → Portainer > Account > Access Tokens > Add access token
#   (qBittorrent uses username/password directly)

- Infrastructure:
    - Nginx Proxy Manager:
        icon: nginx-proxy-manager.png
        href: http://npm.casita.local
        description: Reverse Proxy and SSL
        container: nginx-proxy-manager
        server: docker-local

    - Pi-hole:
        icon: pi-hole.png
        href: http://pihole.casita.local
        description: DNS + Ad-blocker
        container: pihole
        server: docker-local
        widget:
          type: pihole
          url: http://pihole
          version: 6
          key: <PIHOLE_API_KEY>   # Pi-hole > Settings > API / Web interface

    - Portainer:
        icon: portainer.png
        href: https://portainer.casita.local
        description: Visual Docker management
        container: portainer
        server: docker-local
        widget:
          type: portainer
          url: https://portainer:9443
          env: 1
          key: <PORTAINER_API_KEY>   # Portainer > Account > Access Tokens

    - Glances:
        icon: glances.png
        href: http://glances.casita.local
        description: System monitor
        container: glances
        server: docker-local
        widget:
          type: glances
          url: http://glances:61208
          metric: cpu

    - Grafana:
        icon: grafana.png
        href: http://grafana.casita.local
        description: Metrics dashboards
        container: grafana
        server: docker-local

- Media:
    - Jellyfin:
        icon: jellyfin.png
        href: http://jellyfin.casita.local
        description: Streaming server
        container: jellyfin
        server: docker-local
        widget:
          type: jellyfin
          url: http://jellyfin:8096
          key: <JELLYFIN_API_KEY>   # Jellyfin > Dashboard > API Keys
          enableBlocks: true
          enableNowPlaying: true

    - Radarr:
        icon: radarr.png
        href: http://radarr.casita.local
        description: Movie management
        container: radarr
        server: docker-local
        widget:
          type: radarr
          url: http://radarr:7878
          key: <RADARR_API_KEY>    # Radarr > Settings > General > API Key

    - Sonarr:
        icon: sonarr.png
        href: http://sonarr.casita.local
        description: TV series management
        container: sonarr
        server: docker-local
        widget:
          type: sonarr
          url: http://sonarr:8989
          key: <SONARR_API_KEY>    # Sonarr > Settings > General > API Key

    - PhotoPrism Personal:
        icon: photoprism.png
        href: http://fotos.casita.local
        description: Main gallery
        container: photoprism-personal
        server: docker-local

    - PhotoPrism Family:
        icon: photoprism.png
        href: http://familia.casita.local
        description: Shared gallery
        container: photoprism-compartido
        server: docker-local

- Downloads:
    - qBittorrent:
        icon: qbittorrent.png
        href: http://qbit.casita.local
        description: Download client
        container: qbittorrent
        server: docker-local
        widget:
          type: qbittorrent
          url: http://qbittorrent:8080
          username: admin
          password: <QBIT_PASSWORD>   # qBittorrent web panel password

    - Prowlarr:
        icon: prowlarr.png
        href: http://prowlarr.casita.local
        description: Indexer manager
        container: prowlarr
        server: docker-local
        widget:
          type: prowlarr
          url: http://prowlarr:9696
          key: <PROWLARR_API_KEY>  # Prowlarr > Settings > General > API Key

- Other:
    - Bazarr:
        icon: bazarr.png
        href: http://bazarr.casita.local
        description: Subtitles management
        container: bazarr
        server: docker-local
        widget:
          type: bazarr
          url: http://bazarr:6767
          key: <BAZARR_API_KEY>    # Bazarr > Settings > General > API Key


